meta {
  name: create
  type: http
  seq: 1
}

post {
  url: {{url}}/messages/{{channel_id}}
  body: json
  auth: inherit
}

headers {
  Authorization: {{accessToken}}
}

body:json {
  {
    "content": "dupa"
  }
}

settings {
  encodeUrl: true
  timeout: 0
  followRedirects: true
  maxRedirects: 5
  forwardAuthorizationHeader: false
}
